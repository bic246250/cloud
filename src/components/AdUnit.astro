---
/**
 * AdSense ad unit.
 *
 * Slots (created in the AdSense dashboard, 2026-10 / 2026-10-16):
 *   calculators  9151059648   (display, on calculator pages + homepage)
 *   guides       2263226824   (display, lower unit on long guides)
 *   in-article   925728676    (in-article, upper unit on long guides)
 *   utility      5124184721   (display, faq)
 *
 * NOTE ON THE calculators SLOT: it was created as a Multiplex
 * ("autorelaxed") unit, which is a grid layout intended for
 * long-form pages. It is used here on calculator pages, which
 * are short. If it renders poorly or fills empty, recreate it
 * as a standard Display unit and update the ID below.
 */
interface Props {
  slot: string;
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
  responsive?: boolean;
  label?: string;
}

const {
  slot,
  format = 'auto',
  responsive = true,
  label = 'Advertisement',
} = Astro.props;
---

<div class="ad-unit">
  <span class="ad-label">{label}</span>
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-4383269716621209"
       data-ad-slot={slot}
       data-ad-format={format}
       data-full-width-responsive={responsive ? 'true' : 'false'}>
  </ins>
  <!-- The adsbygoogle push for this slot is issued by the deferred AdSense
       loader in Base.astro, once the library has actually loaded. Issuing it
       here would run before window.adsbygoogle exists. -->
</div>

<style>
  .ad-unit {
    margin: 1.5rem 0;
    text-align: center;
    min-height: 90px;
  }
  .ad-label {
    display: block;
    font-size: 0.7rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
</style>
