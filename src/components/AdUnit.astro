---
interface Props {
  slot: string;
  format?: 'auto' | 'horizontal' | 'vertical' | 'rectangle';
  responsive?: boolean;
  label?: string;
}

const {
  slot,
  format = 'auto',
  responsive = true,
  label = 'Advertisement',
} = Astro.props;
---

<div class="ad-unit">
  <span class="ad-label">{label}</span>
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-4383269716621209"
       data-ad-slot={slot}
       data-ad-format={format}
       data-full-width-responsive={responsive ? 'true' : 'false'}>
  </ins>
  <script>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>

<style>
  .ad-unit {
    margin: 1.5rem 0;
    text-align: center;
    min-height: 90px;
  }
  .ad-label {
    display: block;
    font-size: 0.7rem;
    color: var(--color-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.25rem;
  }
</style>
