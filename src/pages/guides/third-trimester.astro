        <tr>
          <td>Preterm</td>
          <td>Before 37 0/7</td>
        </tr>
        <tr>
          <td>Early term</td>
          <td>37 0/7 – 38 6/7</td>
        </tr>
        <tr>
          <td>Full term</td>
          <td>39 0/7 – 40 6/7</td>
        </tr>
        <tr>
          <td>Late term</td>
          <td>41 0/7 – 41 6/7</td>
        </tr>
        <tr>
          <td>Postterm</td>
          <td>42 0/7 and beyond</td>
        </tr>
      </tbody>
    </table>

    <p><em>Source: ACOG Committee Opinion, Definition of Term Pregnancy.</em></p>

