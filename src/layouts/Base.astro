---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  type?: string;
  publishedTime?: string;
  tags?: string[];
  breadcrumbs?: Array<{ name: string; url: string }>;
  jsonLd?: Array<Record<string, unknown>>;
}

const {
  title,
  description = 'Free pregnancy calculators and guides — gestational age, due dates, trimesters, milestones, and more.',
  canonical,
  noindex = false,
  type = 'website',
  publishedTime,
  tags = [],
  breadcrumbs,
  jsonLd: pageJsonLd = [],
} = Astro.props;

const siteTitle = 'Bump Compass';
const fullTitle = title === 'Home' ? siteTitle : `${title} | ${siteTitle}`;
const canonicalURL = canonical ? new URL(canonical, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-default.png', Astro.site);
const isHome = Astro.url.pathname === '/';

// WebSite node — declared on every page so a sitelinks search box can be
// eligible site-wide; the id is referenced from other node types below.
const websiteNode = {
  '@type': 'WebSite',
  '@id': `${Astro.site}#website`,
  name: siteTitle,
  url: Astro.site,
  // Only claim clusters that actually exist. Baby and breastfeeding are
  // planned, not published — asserting them here would be false data.
  description: 'Free pregnancy calculators and guides — gestational age, due dates, trimesters, ovulation, and more.',
  inLanguage: 'en-US',
};

const publisherNode = {
  '@type': 'Organization',
  '@id': `${Astro.site}#organization`,
  name: 'Bump Compass Editorial',
  url: Astro.site,
};

// BreadcrumbList is derived from the pathname unless a page supplies an
// explicit trail (guides need a human label for the middle crumb).
const crumbTrail = breadcrumbs ?? defaultBreadcrumbs(Astro.url.pathname, title);
function defaultBreadcrumbs(pathname: string, pageTitle: string) {
  const trail: Array<{ name: string; url: string }> = [{ name: 'Home', url: '/' }];
  const segments = pathname.split('/').filter(Boolean);
  let acc = '';
  for (let i = 0; i < segments.length; i++) {
    acc += `/${segments[i]}`;
    const isLast = i === segments.length - 1;
    trail.push({
      name: isLast ? pageTitle.replace(` | ${siteTitle}`, '') : titleCase(segments[i]),
      url: acc + '/',
    });
  }
  return trail;
}
function titleCase(segment: string) {
  return segment.split('-').map((w) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
}

const breadcrumbNode = isHome
  ? null
  : {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalURL.href}#breadcrumb`,
      itemListElement: crumbTrail.map((crumb, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: crumb.name,
        item: new URL(crumb.url, Astro.site).href,
      })),
    };

// Article / MedicalWebPage node for content pages (guides). Built in the layout
// so every guide gets the same well-formed node without duplicating it.
const articleNode =
  type === 'article'
    ? {
        '@type': 'Article',
        '@id': `${canonicalURL.href}#article`,
        headline: title,
        description,
        inLanguage: 'en-US',
        datePublished: publishedTime ?? '2026-10-14',
        isPartOf: { '@id': `${Astro.site}#website` },
        author: { '@id': `${Astro.site}#organization` },
        publisher: { '@id': `${Astro.site}#organization` },
        image: ogImage.href,
        articleSection: 'Pregnancy',
        keywords: tags.join(', '),
      }
    : null;

const jsonLdNodes: Array<Record<string, unknown>> = [
  websiteNode,
  publisherNode,
  ...(breadcrumbNode ? [breadcrumbNode] : []),
  ...(articleNode ? [articleNode] : []),
  ...pageJsonLd,
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:site_name" content={siteTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Self-hosted font: preload the latin subset used above the fold -->
    <link rel="preload" href="/fonts/nunito-sans-latin.woff2" as="font" type="font/woff2" crossorigin />

    <!-- AdSense is loaded lazily, before </body>. See the loader at the end of the document. -->
    <!-- JSON-LD: @graph of WebSite + Organization + BreadcrumbList + page nodes -->
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@graph': jsonLdNodes })} />
  </head>
  <body>
    <header class="site-header">
      <div class="header-inner">
        <a href="/" class="logo">
          <img
            src="/images/logo-icon-2x.webp"
            srcset="/images/logo-icon-1x.webp 1x, /images/logo-icon-2x.webp 2x, /images/logo-icon-3x.webp 3x"
            width="41"
            height="44"
            alt=""
            aria-hidden="true"
            decoding="async"
          />
          <span class="logo-text">
            <span class="logo-name">bump<span class="teal">compass</span></span>
            <span class="logo-tagline">Real guidance. Every step.</span>
          </span>
        </a>
        <button class="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" onclick="document.querySelector('.nav-list').classList.toggle('open'); this.setAttribute('aria-expanded', this.getAttribute('aria-expanded') === 'true' ? 'false' : 'true');">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>
        <nav aria-label="Main navigation">
          <ul class="nav-list">
            <li><a href="/gestational-age-calculator/" aria-current={Astro.url.pathname.startsWith('/gestational-age-calculator') ? 'page' : undefined}>Gestational Age</a></li>
            <li><a href="/how-many-weeks-pregnant/" aria-current={Astro.url.pathname.startsWith('/how-many-weeks-pregnant') ? 'page' : undefined}>Weeks Pregnant</a></li>
            <li><a href="/trimester-calculator/" aria-current={Astro.url.pathname.startsWith('/trimester-calculator') ? 'page' : undefined}>Trimester</a></li>
            <li><a href="/conception-date-calculator/" aria-current={Astro.url.pathname.startsWith('/conception-date-calculator') ? 'page' : undefined}>Conception</a></li>
            <li><a href="/pregnancy-milestone-dates/" aria-current={Astro.url.pathname.startsWith('/pregnancy-milestone-dates') ? 'page' : undefined}>Milestones</a></li>
            <li><a href="/due-date-calculator/" aria-current={Astro.url.pathname.startsWith('/due-date-calculator') ? 'page' : undefined}>Due Date</a></li>
            <li><a href="/ovulation-calculator/" aria-current={Astro.url.pathname.startsWith('/ovulation-calculator') ? 'page' : undefined}>Ovulation</a></li>
            <li><a href="/pregnancy-test-tracker/" aria-current={Astro.url.pathname.startsWith('/pregnancy-test-tracker') ? 'page' : undefined}>Test Tracker</a></li>
            <li><a href="/kick-counter/" aria-current={Astro.url.pathname.startsWith('/kick-counter') ? 'page' : undefined}>Kick Counter</a></li>
            <li><a href="/guides/" aria-current={Astro.url.pathname.startsWith('/guides') ? 'page' : undefined}>Guides</a></li>
            <li><a href="/faq/" aria-current={Astro.url.pathname.startsWith('/faq') ? 'page' : undefined}>FAQ</a></li>
            <li><a href="/about/" class="nav-cta" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-inner">
        <div class="footer-grid">
          <div class="footer-brand">
            <img
              src="/images/logo-icon-2x.webp"
              srcset="/images/logo-icon-1x.webp 1x, /images/logo-icon-2x.webp 2x, /images/logo-icon-3x.webp 3x"
              width="37"
              height="40"
              alt=""
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
            <p class="footer-tagline">Real guidance. Every step.</p>
            <p class="footer-desc">Free pregnancy calculators and guides. Every clinical claim is sourced to ACOG, NICHD, Mayo Clinic, or NHS. We show the range where authorities disagree.</p>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Calculators</p>
            <ul>
              <li><a href="/gestational-age-calculator/">Gestational Age</a></li>
              <li><a href="/how-many-weeks-pregnant/">How Many Weeks Pregnant</a></li>
              <li><a href="/trimester-calculator/">Trimester Calculator</a></li>
              <li><a href="/conception-date-calculator/">Conception Date</a></li>
              <li><a href="/pregnancy-milestone-dates/">Milestone Dates</a></li>
              <li><a href="/due-date-calculator/">Due Date Calculator</a></li>
              <li><a href="/ovulation-calculator/">Ovulation Calculator</a></li>
              <li><a href="/pregnancy-test-tracker/">Pregnancy Test Tracker</a></li>
              <li><a href="/kick-counter/">Kick Counter</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Guides</p>
            <ul>
              <li><a href="/guides/first-trimester/">First Trimester</a></li>
              <li><a href="/guides/second-trimester/">Second Trimester</a></li>
              <li><a href="/guides/third-trimester/">Third Trimester</a></li>
              <li><a href="/guides/prenatal-vitamins/">Prenatal Vitamins</a></li>
              <li><a href="/guides/pregnancy-weight-gain/">Weight Gain</a></li>
              <li><a href="/guides/fetal-development/">Fetal Development</a></li>
              <li><a href="/guides/pregnancy-week-by-week/">Week by Week</a></li>
              <li><a href="/guides/gestational-age-explained/">Gestational Age Explained</a></li>
              <li><a href="/guides/due-date-explained/">Due Date Explained</a></li>
              <li><a href="/guides/pregnancy-test-timing/">Pregnancy Test Timing</a></li>
              <li><a href="/guides/sleep-during-pregnancy/">Sleep During Pregnancy</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <p class="footer-col-title">Site</p>
            <ul>
              <li><a href="/about/">About</a></li>
              <li><a href="/faq/">FAQ</a></li>
              <li><a href="/contact/">Contact</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/terms/">Terms</a></li>
              <li><a href="/disclaimer/">Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; {new Date().getFullYear()} Bump Compass Editorial. All rights reserved.</p>
        </div>
      </div>
    </footer>
    <!-- AdSense loader (lazy).
         The adsbygoogle.js script used to sit in <head> with `async`, which
         cost every visitor ~450 KB of JavaScript plus ~1 MB of Google-
         injected webfonts. The stack it pulls in (ads + Funding Choices CMP +
         ad webfonts) totals ~1.4 MB, so loading it unconditionally undid most
         of the page-weight work. Every ad slot on this site is a single unit
         below the fold, so per Google's own guidance
         (web.dev/articles/loading-ads-page-speed) the library is fetched only
         when a slot nears the viewport. No idle or first-interaction fallback:
         a visitor who never scrolls should not pay ~1.4 MB for an ad they
         cannot see, and unviewable impressions are worth nothing anyway. -->
    <script is:inline>
      (function () {
        var CLIENT = 'ca-pub-4383269716621209';
        var SRC = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + CLIENT;
        var state = 'idle'; // idle -> loading -> ready

        function pushUnits() {
          var units = document.querySelectorAll('ins.adsbygoogle:not([data-adsbygoogle-status])');
          for (var i = 0; i < units.length; i++) {
            (window.adsbygoogle = window.adsbygoogle || []).push({});
          }
        }

        function loadAds() {
          if (state !== 'idle') return;
          state = 'loading';
          var s = document.createElement('script');
          s.async = true;
          s.crossOrigin = 'anonymous';
          s.src = SRC;
          s.onload = function () { state = 'ready'; pushUnits(); };
          s.onerror = function () { state = 'idle'; };
          document.head.appendChild(s);
        }

        // If the library is already present (cached, or a bfcache restore),
        // just flush the slots.
        if (window.adsbygoogle) { state = 'ready'; pushUnits(); return; }

        // No ad on this page -> do nothing. (An earlier `if (!units.length)
        // loadAds()` fallback pulled the whole ~1.4 MB ad+CMP stack onto
        // unit-less pages like /get-pdf/ and /guides/, and the Funding
        // Choices banner became their LCP.)
        var units = document.querySelectorAll('.ad-unit');
        if (!units.length) return;

        // Load when a slot nears the viewport. IO is supported everywhere
        // that matters; without it, load immediately rather than never.
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            for (var i = 0; i < entries.length; i++) {
              if (entries[i].isIntersecting) { loadAds(); io.disconnect(); return; }
            }
          }, { rootMargin: '100px 0px' });
          for (var i = 0; i < units.length; i++) io.observe(units[i]);
        } else {
          loadAds();
        }
      })();
    </script>
  </body>
</html>
